
// Simple CRUD simulation using Node.js (Programiz compatible)

const http = require("http");

// In-memory "database"
let products = [
  { id: 1, name: "Laptop", price: 1200, category: "Electronics" },
  { id: 2, name: "Mouse", price: 25, category: "Accessories" },
  { id: 3, name: "Notebook", price: 5, category: "Stationery" }
];

// Helper function to print current database
function showProducts(title) {
  console.log(`\n=== ${title} ===`);
  console.table(products);
}

// Simulate CRUD operations
function simulateCRUD() {
  // CREATE
  const newProduct = { id: 4, name: "Headphones", price: 50, category: "Electronics" };
  products.push(newProduct);
  showProducts("After CREATE");

  // READ
  showProducts("READ All Products");

  // UPDATE
  const idToUpdate = 2;
  const product = products.find(p => p.id === idToUpdate);
  if (product) {
    product.price = 30;
    product.name = "Wireless Mouse";
  }
  showProducts("After UPDATE");

  // DELETE
  const idToDelete = 1;
  products = products.filter(p => p.id !== idToDelete);
  showProducts("After DELETE");
}

// Create simple server
http.createServer((req, res) => {
  res.writeHead(200, { "Content-Type": "text/plain" });
  res.end("Server running on http://localhost:4000");
  simulateCRUD();
}).listen(4000, () => {
  console.log("🚀 Server running on http://localhost:4000");
  simulateCRUD();
});
